<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Shaders\Spv\*.spv" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cubit.Tool" />
    <InternalsVisibleTo Include="Cubit.Editor" />
    <InternalsVisibleTo Include="Cubit.ImGui" />
  </ItemGroup>
</Project>

